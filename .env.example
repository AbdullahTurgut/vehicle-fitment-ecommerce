# ==============================================================================
# CAR MATS E-COMMERCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values before starting Docker Compose
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=carmats_db
POSTGRES_USER=carmats
POSTGRES_PASSWORD=change-this-secure-db-password

# Backend Spring Boot Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION_MS=86400000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Frontend Next.js Configuration
# Leave NEXT_PUBLIC_API_BASE_URL empty to route through same-origin Nginx gateway
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost
NEXT_PUBLIC_WHATSAPP_NUMBER=905550000000

# Nginx Public Gateway Port
NGINX_PORT=80