# ==============================================================================
# CARMATS PRODUCTION ENVIRONMENT TEMPLATE (.env.production.template)
#
# INSTRUCTIONS:
# 1. Copy this file to /opt/carmats/.env on the production VPS.
# 2. Set strict permissions: chmod 600 /opt/carmats/.env
# 3. Generate high-entropy secrets using: openssl rand -hex 32
# 4. NEVER commit the resulting .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & IMAGE TAGS (Immutable Deployment)
# ------------------------------------------------------------------------------
# Set the exact immutable release tag or commit SHA to deploy.
# Never deploy production using 'latest'.
IMAGE_TAG=sha-1a7059a

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 17 Internal)
# ------------------------------------------------------------------------------
POSTGRES_DB=carmats_db_prod
POSTGRES_USER=carmats_prod_user
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_RANDOM_POSTGRES_PASSWORD

# Backend JDBC Connection (Internal Docker Network)
DB_URL=jdbc:postgresql://postgres:5432/carmats_db_prod
DB_USERNAME=carmats_prod_user
DB_PASSWORD=CHANGE_ME_GENERATE_RANDOM_POSTGRES_PASSWORD
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# ------------------------------------------------------------------------------
# 3. BACKEND SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
# Generate: openssl rand -hex 32 (Must be at least 256 bits / 64 hex characters)
JWT_SECRET=CHANGE_ME_GENERATE_64_CHAR_HEX_SECRET_FOR_JWT
JWT_ACCESS_TOKEN_EXPIRATION_MS=86400000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 4. INITIAL ADMINISTRATOR BOOTSTRAPPING (BOOTSTRAP-ONLY)
# ------------------------------------------------------------------------------
# IMPORTANT LIFECYCLE RULE:
# These variables are read ONLY on the very first startup when 0 administrators
# exist in the database. Once the initial admin is created, REMOVE or COMMENT OUT
# ADMIN_INITIAL_PASSWORD from this file. The initializer will never overwrite
# an existing admin on subsequent restarts.
ADMIN_INITIAL_EMAIL=admin@carmats.local
# Generate: openssl rand -base64 18 (Remove after first boot!)
ADMIN_INITIAL_PASSWORD=CHANGE_ME_INITIAL_ADMIN_BOOTSTRAP_PASSWORD
ADMIN_INITIAL_FIRST_NAME=Admin
ADMIN_INITIAL_LAST_NAME=Sistem

# ------------------------------------------------------------------------------
# 5. FRONTEND RUNTIME CONFIGURATION (Next.js 15 Standalone)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
# In production behind Nginx reverse proxy, leave relative ("")
NEXT_PUBLIC_API_BASE_URL=
# Temporary VPS IP (e.g. http://123.45.67.89) or Future Domain (e.g. https://www.carmats.com)
NEXT_PUBLIC_SITE_URL=http://localhost
NEXT_PUBLIC_WHATSAPP_NUMBER=905550000000

# ------------------------------------------------------------------------------
# 6. REVERSE PROXY & GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
NGINX_PORT=80

# ------------------------------------------------------------------------------
# 7. FUTURE PAYMENT & LOGISTICS INTEGRATIONS (Step 21 Placeholders)
# ------------------------------------------------------------------------------
# Leave as MOCK until licensed Turkish payment provider is integrated in Step 21
PAYMENT_PROVIDER=MOCK
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
YURTICI_CARGO_API_KEY=
